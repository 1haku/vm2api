# Build the custom console from the committed source; no generated assets in Git.
ARG PAYLOAD_BASE_IMAGE=node:22-bookworm-slim
FROM node:22-bookworm-slim AS web-build
RUN npm install -g pnpm@10
WORKDIR /build/web
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
# Contract tests compare the browser template migration with the backend catalog.
COPY src/ /build/src/
RUN pnpm test && pnpm build

# Closed-source slot payloads are pinned and SHA256-verified before entering the image.
FROM ${PAYLOAD_BASE_IMAGE} AS payload-build
WORKDIR /build
COPY deploy/payload.json deploy/payload.json
COPY scripts/fetch-payload.mjs scripts/fetch-payload.mjs
RUN node scripts/fetch-payload.mjs --dest /payload

# Keep Go source checks, but ship the exact published helper bytes from payload.
FROM golang:1.26-bookworm AS worker-build
WORKDIR /build/worker
COPY worker/go.mod worker/go.sum ./
RUN go mod download
COPY worker/ ./
RUN go vet ./... && go test -race ./... \
 && mkdir -p /out && printf 'Go vet and race tests passed\n' > /out/worker-source-checks

FROM golang:1.26-bookworm AS api-kernel-build
WORKDIR /build/api-kernel
COPY api-kernel/go.mod api-kernel/go.sum ./
RUN go mod download
COPY api-kernel/ ./
RUN go test -race ./... \
 && CGO_ENABLED=0 go build -trimpath -o /out/kin-api-kernel ./cmd/kin-api-kernel

FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates iptables iproute2 python3 \
  && rm -rf /var/lib/apt/lists/*
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
ARG CUSTOM_REVISION=unknown
WORKDIR /opt/vm2api
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY src ./src
COPY scripts ./scripts
COPY VERSION CHANGELOG.md ./
COPY docker/kin-os ./docker/kin-os
COPY docker/kin-kvm ./docker/kin-kvm
COPY --from=web-build /build/web/dist ./web/dist
COPY --from=payload-build /payload/bin/ /opt/vm2api/image-bin/
COPY --from=worker-build /out/worker-source-checks /opt/vm2api/deploy/worker-source-checks
COPY --from=api-kernel-build /out/ /opt/vm2api/image-bin/
COPY share/wrap-cli /opt/vm2api/image-wrap-cli
COPY --from=payload-build /payload/share/wrap-cli/ /opt/vm2api/image-wrap-cli/
COPY --from=payload-build /payload/share/crag/ /opt/vm2api/image-crag/
COPY deploy/payload.json ./deploy/payload.json
COPY scripts/docker-entrypoint.sh /usr/local/bin/vm2api-entrypoint
RUN chmod 755 /usr/local/bin/vm2api-entrypoint /opt/vm2api/image-bin/* \
  && chmod 755 /opt/vm2api/image-wrap-cli/cli-node /opt/vm2api/image-wrap-cli/cc-node \
  && cp /opt/vm2api/image-bin/kin-kernel /opt/vm2api/image-wrap-cli/kin-kernel.bin \
  && rm -f /opt/vm2api/src/lib/oauth/auth.js \
  && cp -a /opt/vm2api/src/config /opt/vm2api/image-config \
  && mkdir -p /opt/vm2api/vms /opt/vm2api/data /opt/vm2api/bin /opt/vm2api/share
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8787 \
    KIN_PROJECT_ROOT=/opt/vm2api \
    KIN_DATA_DIR=/opt/vm2api/data \
    KIN_KERNEL_BIN=/opt/vm2api/bin/kin-kernel \
    KIN_EGRESS_BIN=/opt/vm2api/bin/kin-egress \
    KIN_WORKER_BIN=/opt/vm2api/bin/kin-worker \
    KIN_CODEX_KERNEL_BIN=/opt/vm2api/bin/kin-codex-kernel \
    KIN_OAUTH_AUTH_BIN=/opt/vm2api/bin/kin-oauth-auth \
    KIN_COMPUTER_BIN=/opt/vm2api/bin/kin-computer \
    KIN_API_KERNEL_BIN=/opt/vm2api/bin/kin-api-kernel
RUN node scripts/subscriptions-manifest.mjs "$CUSTOM_REVISION"
ENV VM2API_CUSTOM_BUILD=subscriptions-v8
LABEL org.vm2api.variant="shared-subscriptions-v8" org.opencontainers.image.revision=$CUSTOM_REVISION
EXPOSE 8787
ENTRYPOINT ["/usr/local/bin/vm2api-entrypoint"]
